# ============================================================
# Copy to .env.base / .env.dev / .env.prod and fill in values.
# .env.base is loaded in every environment; .env.dev or .env.prod
# is layered on top (later wins).
# ============================================================

# --- Postgres (init + client) ---
POSTGRES_DB=wealth
POSTGRES_USER=wealth
POSTGRES_PASSWORD=wealth_dev_pw

DB_NAME=wealth
DB_USER=wealth
DB_PASSWORD=wealth_dev_pw
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
SECRET_KEY=dev-only-secret-do-not-use-in-prod

# --- Per-environment (mirror these in .env.dev / .env.prod) ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
VITE_API_URL=http://localhost:8000/api/v1/
